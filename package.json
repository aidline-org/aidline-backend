{
  "name": "aidline-backend",
  "version": "0.1.0",
  "description": "API and Soroban event indexer for Aidline, transparent funding for disaster relief and climate action",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:db": "tsx scripts/dev-db.ts",
    "build": "tsc -p tsconfig.build.json && cp -r src/db/migrations dist/db/",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "reindex": "tsx --env-file-if-exists=.env src/indexer/reindex.ts",
    "metadata:orphans": "tsx --env-file-if-exists=.env src/indexer/metadata-orphans.ts",
    "stats:backfill": "tsx --env-file-if-exists=.env src/indexer/stats-backfill.ts",
    "test": "vitest run",
    "test:e2e:indexer": "tsx --env-file-if-exists=.env test/indexer-soroban.e2e.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "seed:demo": "tsx --env-file-if-exists=.env scripts/seed-demo.ts"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^10.1.12",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.5",
    "@stellar/stellar-sdk": "^17.4.0",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^10.15.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "@embedded-postgres/darwin-x64": true,
    "@embedded-postgres/darwin-arm64": true,
    "@embedded-postgres/linux-x64": true,
    "@embedded-postgres/linux-arm64": true,
    "@embedded-postgres/windows-x64": true,
    "esbuild": true
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
