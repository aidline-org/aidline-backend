# Server
PORT=4000
HOST=0.0.0.0
# Public URL of this API. Used to build metadata and proof URIs stored on chain.
PUBLIC_BASE_URL=http://localhost:4000
# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Database (npm run dev:db starts a local Postgres on this URL)
DATABASE_URL=postgres://aidline:aidline@localhost:5433/aidline
# Cancel queries that run longer than this (ms). Migrations are not limited.
DATABASE_STATEMENT_TIMEOUT_MS=5000
# Hosted Postgres (e.g. Neon): use a development-only database and require TLS.
# DATABASE_URL=postgres://USER:PASSWORD@HOST/aidline_dev?sslmode=require

# Stellar
AIDLINE_NETWORK=testnet
AIDLINE_RPC_URL=https://soroban-testnet.stellar.org
AIDLINE_CONTRACT_ID=
AIDLINE_TOKEN_ID=
# Ledger to start indexing from on first run (the deploy ledger is ideal)
INDEXER_START_LEDGER=
INDEXER_POLL_MS=5000
INDEXER_ENABLED=true

# Serve Prometheus metrics at GET /metrics
METRICS_ENABLED=true

# Uploads. local is the default; s3 works with any S3 compatible provider.
# Public proof URLs stay at PUBLIC_BASE_URL/uploads/... with either driver.
UPLOAD_DIR=uploads
STORAGE_DRIVER=local
# Required when STORAGE_DRIVER=s3 (leave empty for local):
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=true

# GDACS disaster alerts (orange and red only)
GDACS_ENABLED=true
GDACS_FEED_URL=https://www.gdacs.org/xml/rss.xml
GDACS_POLL_MS=300000

# Webhook notifications for milestone releases
WEBHOOK_POLL_MS=5000
WEBHOOK_MAX_ATTEMPTS=5
# Only enable for a local fake receiver in development/tests.
WEBHOOK_ALLOW_PRIVATE_URLS=false
